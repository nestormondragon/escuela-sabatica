{
  "name": "escuela-sabatica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mosaico Vivo de Corinto · Escuela Sabática Q3 2026",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:visuals": "node scripts/build-visual-assets.mjs",
    "build:lessons": "node scripts/build-lessons.mjs",
    "qa:content": "node scripts/qa-structure.mjs && node scripts/qa-templates.mjs",
    "qa:browser": "node scripts/verify-overhaul.mjs",
    "qa:release": "node scripts/verify-release.mjs",
    "test:journey": "node --test tests/journey/journey.test.mjs",
    "qa": "npm run build:lessons && npm run qa:content && npm run test:journey && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.17",
    "html-to-image": "^1.11.11",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.7",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "paper": "^0.12.18",
    "playwright": "^1.62.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "vite": "^8.1.5"
  }
}
